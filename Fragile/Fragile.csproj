<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>1.0.0</Version>
        <Authors>Fragile Team</Authors>
        <Description>A custom file archiving library for .NET with advanced compression, encryption, and data integrity features.</Description>
        <PackageProjectUrl>https://github.com/fragile-team/fragile</PackageProjectUrl>
        <RepositoryUrl>https://github.com/fragile-team/fragile</RepositoryUrl>
        <PackageTags>archive, compression, encryption, data-integrity, error-correction</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <LangVersion>preview</LangVersion>
        <AnalysisLevel>preview</AnalysisLevel>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Text.Json" Version="9.0.4" />
    </ItemGroup>

</Project>
