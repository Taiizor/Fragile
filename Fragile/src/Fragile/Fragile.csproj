<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>10.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Fragile</RootNamespace>
        <AssemblyName>Fragile</AssemblyName>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>A custom file archiving library for .NET with advanced features.</Description>
        <Authors>Your Name / Company</Authors>
        <PackageTags>archive;compression;encryption;file;fragile</PackageTags>
        <RepositoryUrl>https://github.com/your-repo/Fragile</RepositoryUrl>
        <Version>0.1.0-alpha</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Text.Json" Version="9.0.4" />
    </ItemGroup>

</Project>